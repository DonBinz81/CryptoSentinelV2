<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Solo HTTPS. Il backend sta dietro nginx con certificato Let's Encrypt
         su cryptosentinelv2.duckdns.org, quindi non serve alcuna eccezione
         in chiaro. Per usare un backend locale in sviluppo, aggiungere qui un
         <domain-config cleartextTrafficPermitted="true"> con quell'indirizzo. -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
