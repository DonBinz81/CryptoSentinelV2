<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+ forza l'edge-to-edge e ignora statusBarColor.
         Questo opt-out ripristina il comportamento pre-API 35
         evitando la fascia bianca sopra la WebView.

         I temi estendono AppThemeBase: una risorsa qualificata SOSTITUISCE
         quella base invece di fondersi, quindi ridichiarandoli con parent
         Theme.AppCompat si perderebbero colori e tema dei dialoghi su
         Android 15+ (era il caso prima di questa correzione: l'accento
         tornava al verde acqua di default). -->
    <style name="AppTheme" parent="AppThemeBase">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="AppThemeBase">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
