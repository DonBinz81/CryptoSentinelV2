[Unit]
Description=CryptoSentinelV2 database corruption watchdog

[Service]
Type=oneshot
User=cryptosentinelv2
Group=cryptosentinelv2
# Same order as the backend unit: the admin token is defined in both files and
# the second one wins.
EnvironmentFile=-/etc/cryptosentinelv2/backend.env
EnvironmentFile=/opt/cryptosentinelv2/app/.env
ExecStart=/opt/cryptosentinelv2/app/deploy/scripts/db_watchdog.sh
# Needed to read the backend journal; the service stays otherwise unprivileged
# and runs as the same user as the backend, which is what allows reading its
# /proc/<pid>/fd without elevation.
SupplementaryGroups=systemd-journal
StateDirectory=cryptosentinelv2-db-watchdog
UMask=0077
Nice=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/cryptosentinelv2/app
